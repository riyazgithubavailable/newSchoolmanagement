      "key": "resetToken",
      "value": ""
    },
    {
      "key": "principalId",
      "value": ""
    },
    {
      "key": "sectionId",
      "value": ""
    },
    {
      "key": "subjectId",
      "value": ""
    },
    {
      "key": "teacherId",
      "value": ""
    }
