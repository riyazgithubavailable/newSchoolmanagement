{
  "info": {
    "name": "InstituteOS API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "School management REST API (web + Android). Run \"Login\" first — it stores the tokens automatically.\n\nFull interactive docs: http://localhost:5000/api/docs"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
