# Copy this file to `.env` and fill in real values. Never commit `.env`.

# Server
PORT=5000
NODE_ENV=development

# MongoDB Atlas → Connect → Drivers → copy the connection string.
# Replace <db_password> with your database user's password.
MONGODB_URI=mongodb+srv://<user>:<db_password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Database name inside the cluster (created automatically on first write)
MONGODB_DB_NAME=school_dev

# Comma separated list of frontends allowed to call the API (web app dev server)
# school web app and Platform Admin app (production: e.g. https://app.yourdomain.com,https://admin.yourdomain.com)
CORS_ORIGIN=http://localhost:8080,http://localhost:8081

# JWT — generate long random values, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Use different secrets for development and production.
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Optional: passwords used by `npm run seed` (required in production)
# SEED_SUPERADMIN_EMAIL=superadmin@instituteos.local
# SEED_SUPERADMIN_PASSWORD=
# SEED_PRINCIPAL_PASSWORD=

# Platform owner (Platform Admin app) security
# Comma separated IPs allowed to reach /api/v1/platform/* — empty = any IP.
PLATFORM_ALLOWED_IPS=
# Platform sessions are short (school users: JWT_REFRESH_EXPIRES_IN)
PLATFORM_REFRESH_EXPIRES_IN=1d
# Key used to encrypt 2FA secrets in the database (long random string).
# If empty, a key derived from JWT_REFRESH_SECRET is used. Set it explicitly in production.
ENCRYPTION_KEY=

# Web app address used in email links (password reset)
WEB_APP_URL=http://localhost:8080

# Email (optional). Leave SMTP_HOST empty in development → emails are printed in the terminal.
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=you@gmail.com, SMTP_PASS=<app password>
MAIL_FROM=InstituteOS <no-reply@yourdomain.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
