# Copy this file to `.env` and fill in real values. Never commit `.env`.

# Server
PORT=5000
NODE_ENV=development

# MongoDB Atlas → Connect → Drivers → copy the connection string.
# Replace <db_password> with your database user's password.
MONGODB_URI=mongodb+srv://<user>:<db_password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Database name inside the cluster (created automatically on first write)
MONGODB_DB_NAME=school_dev

# Comma separated list of frontends allowed to call the API (web app dev server)
CORS_ORIGIN=http://localhost:8080,http://localhost:5173

# JWT — generate long random values, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Use different secrets for development and production.
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Optional: passwords used by `npm run seed` (required in production)
# SEED_SUPERADMIN_EMAIL=superadmin@instituteos.local
# SEED_SUPERADMIN_PASSWORD=
# SEED_PRINCIPAL_PASSWORD=
